+def _collapse_vulnerabilities(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Merge records connected by their primary IDs or aliases."""
+    groups: list[tuple[VulnerabilityResult, set[str]]] = []
+    for vulnerability in vulnerabilities:
+        identifiers = set(vulnerability.aliases) | {vulnerability.id}
+        matches = [
+            index for index, (_, ids) in enumerate(groups) if ids & identifiers
+        ]
+        if not matches:
+            groups.append((vulnerability, identifiers))
+            continue
+
+        # Existing groups are disjoint, so all groups connected by this record
+        # can be merged at once. Keep the first group's position in the output.
+        records = [groups[index][0] for index in matches] + [vulnerability]
+        for index in matches:
+            identifiers.update(groups[index][1])
+        representative = next(
+            (record for record in records if record.id.startswith("PYSEC")),
+            records[0],
+        )
+        groups[matches[0]] = (representative, identifiers)
+        for index in reversed(matches[1:]):
+            del groups[index]
+
+    return [
+        replace(record, aliases=identifiers - {record.id})
+        for record, identifiers in groups
+    ]
 
 
