#!/usr/bin/env bash
# Read-only notice after a commit rewrite (such as rebase).
#
# Automatic commit/amend behavior has been removed so no hook mutates a reviewed
# Git head. Generated documentation build products (docs/INDEX.md, docs/repo-map.md)
# must be updated explicitly via `make docs` and verified with `make check`.
set -uo pipefail

[ "${1:-}" = "rebase" ] || exit 0

echo "post-rewrite notice: if rebase altered documentation or repository structure, run 'make docs' to regenerate build products."
