 from __future__ import annotations
 
 MAGIC = b"G2"
 VERSION = 2
+FLAG_AUX = 0x01
+FLAG_EXT = 0x02
+RESERVED_FLAGS = 0xFF & ~(FLAG_AUX | FLAG_EXT)
