 from evalrun.store import ResultStore
 
 
+class _RoutineThrottle:
+    """Job-level throttle for the backfill (BACKFILL-212).
+
+    Historical runs would otherwise emit one routine ``info`` summary each to the
+    results channel and bury live threads. Per POLICY.md, routine summaries may be
+    throttled by individual jobs; every other severity (P2/P1/P0 pages and pings)
+    is passed straight through to the real dispatcher.
+    """
+
+    def __init__(self, inner: AlertDispatcher) -> None:
+        self._inner = inner
+
+    def dispatch(self, alert: Alert) -> list[str]:
+        if alert.severity == "info":
+            return []
+        return self._inner.dispatch(alert)
+
+
 def backfill(settings: Settings, runs: list[dict]) -> dict:
     store = ResultStore(settings.result_store)
-    dispatcher = AlertDispatcher(settings)
+    dispatcher = _RoutineThrottle(AlertDispatcher(settings))
     severities: dict[str, int] = {}
     try:
         for run in runs:
