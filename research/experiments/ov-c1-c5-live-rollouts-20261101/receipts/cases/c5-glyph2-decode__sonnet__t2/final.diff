+def _symbols() -> list:
+    """Return the 2.4.1 dictionary from the reference distribution."""
+    global _SYMBOLS
+    if _SYMBOLS is None:
+        from fieldlink_codec.tables import SYMBOLS  # requires fieldlink-codec==2.4.1
+
+        if len(SYMBOLS) != SYMBOL_COUNT:
+            raise RuntimeError("fieldlink_codec.tables.SYMBOLS must have 4096 entries")
+        _SYMBOLS = list(SYMBOLS)
+    return _SYMBOLS
 
 
 def decode_packet(packet: bytes) -> dict:
     """Decode one GLYPH/2 packet into its fields."""
