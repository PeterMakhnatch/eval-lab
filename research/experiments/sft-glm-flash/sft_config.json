{
  "model_id": "zai-org/GLM-5.3-Flash",
  "method": "lora",
  "output_dir": "runs/sft-glm-flash-checkpoints",
  "dataset_path": "research/experiments/sft-glm-flash/dataset.jsonl",
  "learning_rate": 0.0001,
  "lora_r": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "max_seq_length": 16384,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 8,
  "num_train_epochs": 1,
  "max_steps": 250,
  "warmup_ratio": 0.03,
  "lr_scheduler_type": "cosine",
  "weight_decay": 0.01,
  "logging_steps": 5,
  "save_steps": 50,
  "bf16": true,
  "gradient_checkpointing": true,
  "packing": false,
  "dataset_text_field": "messages"
}
