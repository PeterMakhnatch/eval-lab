{
  "$defs": {
    "CohortComparisonSpec": {
      "additionalProperties": false,
      "properties": {
        "budget_exhaustion_is_failure": {
          "default": false,
          "title": "Budget Exhaustion Is Failure",
          "type": "boolean"
        },
        "cohorts": {
          "items": {
            "$ref": "#/$defs/CohortSelector"
          },
          "minItems": 2,
          "title": "Cohorts",
          "type": "array"
        },
        "comparison_id": {
          "minLength": 3,
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Comparison Id",
          "type": "string"
        },
        "constraints": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "task_digest",
              "verifier_digest",
              "environment_digest"
            ]
          },
          "title": "Constraints",
          "type": "object"
        },
        "declared_variable": {
          "enum": [
            "agent_name",
            "agent_version",
            "model_name",
            "model_settings_digest",
            "environment_digest",
            "preamble_hash",
            "preamble_content_sha256",
            "toolset_digest",
            "factor_values_digest",
            "factor_bindings_digest",
            "bound_execution_values_digest"
          ],
          "title": "Declared Variable",
          "type": "string"
        },
        "experiment_id": {
          "minLength": 1,
          "title": "Experiment Id",
          "type": "string"
        },
        "mode": {
          "default": "causal",
          "enum": [
            "causal",
            "exploratory"
          ],
          "title": "Mode",
          "type": "string"
        },
        "pairing_key": {
          "default": "task_digest",
          "enum": [
            "task_block_id",
            "task_digest",
            "task_name",
            "trial_name"
          ],
          "title": "Pairing Key",
          "type": "string"
        },
        "pass_k": {
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Pass K",
          "type": "array"
        },
        "pass_threshold": {
          "default": 1.0,
          "title": "Pass Threshold",
          "type": "number"
        },
        "reward_name": {
          "default": "reward",
          "title": "Reward Name",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        }
      },
      "required": [
        "comparison_id",
        "experiment_id",
        "declared_variable",
        "cohorts"
      ],
      "title": "CohortComparisonSpec",
      "type": "object"
    },
    "CohortSelector": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]+$",
          "title": "Label",
          "type": "string"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Paths",
          "type": "array"
        },
        "trial_names": {
          "items": {
            "type": "string"
          },
          "title": "Trial Names",
          "type": "array"
        }
      },
      "required": [
        "label",
        "paths"
      ],
      "title": "CohortSelector",
      "type": "object"
    },
    "CurveComparisonSource": {
      "additionalProperties": false,
      "description": "One reference-versus-level comparison, either live or already frozen.",
      "properties": {
        "comparison_artifact": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Artifact"
        },
        "comparison_artifact_digest": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comparison Artifact Digest"
        },
        "comparison_spec": {
          "anyOf": [
            {
              "$ref": "#/$defs/CohortComparisonSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Level"
        }
      },
      "required": [
        "level"
      ],
      "title": "CurveComparisonSource",
      "type": "object"
    },
    "CurvePrimaryContrast": {
      "additionalProperties": false,
      "description": "The single preregistered inferential contrast on an empirical curve.",
      "properties": {
        "k": {
          "minimum": 1,
          "title": "K",
          "type": "integer"
        },
        "level": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            }
          ],
          "title": "Level"
        }
      },
      "required": [
        "level",
        "k"
      ],
      "title": "CurvePrimaryContrast",
      "type": "object"
    },
    "PreregSpec": {
      "additionalProperties": false,
      "description": "\u00a72.1 / \u00a74 Preregistration block for comparison experiments.\n\nStored verbatim and quoted by the eval card to prevent post-hoc goalpost moving.\nBoth expected outcome and decision rule survive round-tripping unmodified.",
      "properties": {
        "decision_rule": {
          "description": "pre-agreed decision rule for hypothesis acceptance verbatim",
          "minLength": 1,
          "title": "Decision Rule",
          "type": "string"
        },
        "expected": {
          "description": "expected result or hypothesis outcome statement verbatim",
          "minLength": 1,
          "title": "Expected",
          "type": "string"
        }
      },
      "required": [
        "expected",
        "decision_rule"
      ],
      "title": "PreregSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Strict empirical curve contract; it intentionally has no fitted-model fields.",
  "properties": {
    "comparisons": {
      "items": {
        "$ref": "#/$defs/CurveComparisonSource"
      },
      "minItems": 1,
      "title": "Comparisons",
      "type": "array"
    },
    "curve_id": {
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9-]+$",
      "title": "Curve Id",
      "type": "string"
    },
    "factor_kind": {
      "enum": [
        "execution",
        "task_generator"
      ],
      "title": "Factor Kind",
      "type": "string"
    },
    "factor_name": {
      "minLength": 1,
      "title": "Factor Name",
      "type": "string"
    },
    "factor_unit": {
      "minLength": 1,
      "title": "Factor Unit",
      "type": "string"
    },
    "ordered_levels": {
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          }
        ]
      },
      "minItems": 2,
      "title": "Ordered Levels",
      "type": "array"
    },
    "prereg": {
      "$ref": "#/$defs/PreregSpec"
    },
    "primary_contrast": {
      "$ref": "#/$defs/CurvePrimaryContrast"
    },
    "reference_level": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        }
      ],
      "title": "Reference Level"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "treatment_binding": {
      "anyOf": [
        {
          "enum": [
            "concurrency",
            "timeout_seconds"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Treatment Binding"
    }
  },
  "required": [
    "curve_id",
    "factor_name",
    "factor_unit",
    "factor_kind",
    "ordered_levels",
    "reference_level",
    "primary_contrast",
    "prereg",
    "comparisons"
  ],
  "title": "CapabilityCurveSpec",
  "type": "object"
}
