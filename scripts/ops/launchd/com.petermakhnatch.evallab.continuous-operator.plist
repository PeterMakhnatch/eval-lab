<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.petermakhnatch.evallab.continuous-operator</string>
	<key>Disabled</key>
	<true/>
	<key>RunAtLoad</key>
	<false/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>WorkingDirectory</key>
	<string>/usr/local/libexec/evallab</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/evallab/.venv/bin/python</string>
		<string>-m</string>
		<string>evallab.ops_continuous</string>
		<string>validate</string>
		<string>--state-dir</string>
		<string>__EVAL_LAB_STATE_DIR__</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>EVAL_LAB_OPERATOR_LOG_DIR</key>
		<string>__EVAL_LAB_LOG_DIR__</string>
	</dict>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>__EVAL_LAB_LOG_DIR__/continuous-operator.out</string>
	<key>StandardErrorPath</key>
	<string>__EVAL_LAB_LOG_DIR__/continuous-operator.err</string>
</dict>
</plist>
