+def _deduplicate(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Collapse connected groups of results that share identifiers."""
+    parents = list(range(len(vulnerabilities)))
+
+    def root(index: int) -> int:
+        while parents[index] != index:
+            parents[index] = parents[parents[index]]
+            index = parents[index]
+        return index
+
+    identifiers = [v.aliases | {v.id} for v in vulnerabilities]
+    for i, ids in enumerate(identifiers):
+        for j in range(i):
+            if ids & identifiers[j]:
+                parents[root(i)] = root(j)
+
+    groups: dict[int, list[int]] = {}
+    for i in range(len(vulnerabilities)):
+        groups.setdefault(root(i), []).append(i)
+
+    results = []
+    for indices in groups.values():
+        if len(indices) == 1:
+            results.append(vulnerabilities[indices[0]])
+            continue
+        chosen = next(
+            (vulnerabilities[i] for i in indices if vulnerabilities[i].id.startswith("PYSEC")),
+            vulnerabilities[indices[0]],
+        )
+        aliases = set().union(*(identifiers[i] for i in indices))
+        aliases.discard(chosen.id)
+        results.append(replace(chosen, aliases=aliases))
+    return results
