+def _stream_model_step(model, messages, on_delta):
+    """Consume one ``model.stream()`` pass; return ``(text, tool_calls)`` assembled from the deltas."""
+    text, calls = "", {}
+    for chunk in model.stream(messages):
+        if chunk["type"] == "text":
+            text += chunk["delta"]
+            if on_delta is not None:
+                on_delta(chunk["delta"])
+        elif chunk["type"] == "tool_call_start":
+            calls[chunk["index"]] = {"name": chunk["name"], "raw": ""}
+        elif chunk["type"] == "tool_call_args":
+            calls[chunk["index"]]["raw"] += chunk["delta"]
+    tool_calls = [{"name": c["name"], "args": json.loads(c["raw"])} for _, c in sorted(calls.items())]
+    return text, tool_calls
+
