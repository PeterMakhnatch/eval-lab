+def rawResponse(fun):
+    """
+    This is a decorator that can be placed on REST route handlers, and is
+    equivalent to calling ``setRawResponse()`` in the handler body.
+    """
+    @six.wraps(fun)
+    def wrapped(*args, **kwargs):
+        setRawResponse()
+        return fun(*args, **kwargs)
+    return wrapped
