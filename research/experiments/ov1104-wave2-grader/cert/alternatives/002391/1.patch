+def _collapse_vulnerabilities(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Merge connected sets of advisory identifiers without mutating service results."""
+    # Each group contains the indices of its records and all their identifiers.
+    groups: list[tuple[list[int], set[str]]] = []
+    for index, vulnerability in enumerate(vulnerabilities):
+        indices = [index]
+        identifiers = set(vulnerability.aliases) | {vulnerability.id}
+        remaining = []
+        for group_indices, group_ids in groups:
+            if identifiers & group_ids:
+                indices.extend(group_indices)
+                identifiers.update(group_ids)
+            else:
+                remaining.append ( (group_indices, group_ids) )
+        remaining.append((indices, identifiers))
+        groups = remaining
+
+    collapsed = []
+    for indices, identifiers in sorted(groups, key=lambda group: min(group[0])):
+        indices.sort()
+        preferred = next(
+            (i for i in indices if vulnerabilities[i].id.startswith("PYSEC")),
+            indices[0],
+        )
+        result = vulnerabilities[preferred]
+        collapsed.append(replace(result, aliases=identifiers - {result.id}))
+    return collapsed
 
 
