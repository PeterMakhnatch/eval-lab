<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.petermakhnatch.evallab.continuous-operator</string>
	<key>Disabled</key>
	<true/>
	<key>RunAtLoad</key>
	<false/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/evallab/.venv/bin/python</string>
		<string>-m</string>
		<string>evallab.ops_continuous</string>
		<string>validate</string>
		<string>--state-dir</string>
		<string>/opt/evallab/operator-state</string>
	</array>
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>~/Library/Logs/evallab/continuous-operator.log</string>
	<key>StandardErrorPath</key>
	<string>~/Library/Logs/evallab/continuous-operator.error.log</string>
</dict>
</plist>
