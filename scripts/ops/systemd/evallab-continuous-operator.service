[Unit]
Description=Eval Lab continuous operator (disabled by default)
Documentation=docs/continuous-loop-operator.md
After=network-online.target
# Do not pull in docker or postgres. No services or runs authorized.

[Service]
Type=oneshot
User=evallab
Group=evallab
ExecStart=/opt/evallab/.venv/bin/python -m evallab.ops_continuous validate --state-dir /var/lib/evallab/operator-state
WorkingDirectory=/opt/evallab
RemainAfterExit=no
Restart=no
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/evallab/operator-state
LogsDirectory=evallab
StateDirectory=evallab-operator
StateDirectoryMode=0700
LogsDirectoryMode=0750

[Install]
# Intentionally empty Install section. Do not enable on boot.
# Enable only after an explicit operator token, standing approval, and budget.
