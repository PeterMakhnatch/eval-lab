--- /dev/null
+++ b/cupy/sparse/util.py
@@ -0,0 +1,5 @@
+def isshape(x):
+    if not isinstance(x, tuple) and len(x) != 2:
+        return False
+    m, n = x
+    return int(m) == m and int(n) == n
