+@SNS.filter_registry.register('kms-key')
+class SNSKmsFilter(KmsRelatedFilter):
+    """Filter topics by attributes of their associated KMS key.
+
+    Use ``c7n:AliasName`` to match a key alias. To include unencrypted
+    topics when selecting topics without an approved key, combine a
+    ``KmsMasterKeyId: absent`` value filter with a negated kms-key filter.
+    """
+
+    RelatedIdsExpression = 'KmsMasterKeyId'
+    permissions = ('kms:DescribeKey', 'kms:ListAliases')
+
+
+@SNS.action_registry.register('set-encryption')
+class SetEncryption(BaseAction):
+    """Enable, change, or disable server-side encryption on SNS topics.
+
+    ``key`` accepts a KMS key ID, ARN, alias name, or alias ARN. If omitted
+    when enabling encryption, the SNS managed key is used. Set ``state`` to
+    false to disable encryption.
+
+    :example:
+
+    .. code-block:: yaml
+
+        policies:
+          - name: sns-encrypt
+            resource: sns
+            filters:
+              - KmsMasterKeyId: absent
+            actions:
+              - type: set-encryption
+                key: alias/approved-key
+    """
+
+    schema = type_schema(
+        'set-encryption', state={'type': 'boolean'},
+        key={'type': 'string', 'minLength': 1})
+    permissions = ('sns:SetTopicAttributes',)
+
+    def process(self, resources):
+        client = local_session(self.manager.session_factory).client('sns')
+        key = self.data.get('key', 'alias/aws/sns') if self.data.get('state', True) else ''
+        for resource in resources:
+            client.set_topic_attributes(
+                TopicArn=resource['TopicArn'],
+                AttributeName='KmsMasterKeyId',
+                AttributeValue=key)
+
+
 class SNSPolicyChecker(PolicyChecker):
 
