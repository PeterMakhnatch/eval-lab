+def _collapse_vulnerabilities(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Merge connected groups of results that share advisory identifiers."""
+    groups: list[tuple[set[str], list[tuple[int, VulnerabilityResult]]]] = []
+    for index, vulnerability in enumerate(vulnerabilities):
+        identifiers: set[str] = set(vulnerability.aliases) | {vulnerability.id}
+        members = [(index, vulnerability)]
+        remaining = []
+        for group_ids, group_members in groups:
+            if identifiers & group_ids:
+                identifiers.update(group_ids)
+                members.extend(group_members)
+            else:
+                remaining.append((group_ids, group_members))
+        remaining.append((identifiers, members))
+        groups = remaining
+
+    # Preserve the position of the first result in each group, while preferring
+    # a PYSEC result for the group's metadata and primary identifier.
+    groups.sort(key=lambda group: min(index for index, _ in group[1]))
+    collapsed = []
+    for identifiers, members in groups:
+        members.sort(key=lambda member: member[0])
+        representative = next(
+            (result for _, result in members if result.id.startswith("PYSEC")),
+            members[0][1],
+        )
+        if len(members) == 1:
+            collapsed.append(representative)
+        else:
+            aliases = set(representative.aliases)
+            for _, result in members:
+                aliases.add(result.id)
+                aliases.update(result.aliases)
+            aliases.discard(representative.id)
+            collapsed.append(replace(representative, aliases=aliases))
+    return collapsed
 
 
