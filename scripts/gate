#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.."
export UV_PYTHON=3.12

uv sync --frozen
uv run --no-sync ruff check .
uvx ty@0.0.71 check src/ tidegauge/ muster/ campaign/ worldwatch/ --exclude 'muster/tasks/**' --output-format=concise
uv run --no-sync python tools/check_tigerstyle_worldwatch.py
uv run --no-sync python scripts/gates/sealed-search.py
uv run --no-sync python -m compileall -q -x '(^|/)muster/tasks/[^/]+/build(/|$)' src scripts tools tidegauge muster campaign worldwatch
uv run --no-sync evallab registry audit --json
uv run --no-sync evallab tasks lint library/tasks
uv run --no-sync evallab tasks lint library/external/terminal-bench-v3.0.0/tasks
uv run --no-sync evallab tasks lint library/benchmarks/hello-world library/benchmarks/humanevalfix
uv run --no-sync python -m evallab.smoke --docker-free
uv run --no-sync python -m evallab.sim check
uv run --no-sync python -m tidegauge.sim check
uv run --no-sync python -m muster.sim check
uv run --no-sync python -m muster.lab.sim check
uv run --no-sync python -m campaign.sim check
uv run --no-sync python -m worldwatch.sim check
for family in boxes ledger commons scarce crowd field crowdrules horde standin standing_v1 trustcal_v1 crowdscale_v1 stalehand_v1; do
  uv run --no-sync python "muster/tasks/$family/generate.py" --check
done
for family in depot dossier inquiry; do
  uv run --no-sync python "muster/tasks/$family/generate.py" --check
  uv run --no-sync python -m muster card "$family" --verify --jobs 0
done
