# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
auth.json

# Generated experiment state
/runs/
/exports/
/operator-state/
/queue/
/derived/*
!/derived/parquet/
/derived/parquet/*
!/derived/parquet/craft/
/derived/parquet/craft/*
!/derived/parquet/craft/craft.parquet
!/derived/parquet/compact/
/derived/parquet/compact/*
!/derived/parquet/compact/dt=*/
/derived/parquet/compact/dt=*/**
!/derived/parquet/compact/dt=*/trial_facts.parquet
/backups/
/logs/
/notebooks/.ipynb_checkpoints/
/excalidraw.log

# Authoring quarantine: proposals are unqualified until a human registers them,
# so they must never be committable from the working tree.
/library/tasks/_proposed/

# Local database and tooling
postgres-data/
.coverage
htmlcov/

# Local tool caches (regenerable; e.g. ACP agent-registry manifests)
.cache/

# Not-yet-vendored external clones under research/external/harbor-ecosystem/vendor/.
# Each is a full git clone at its README-pinned commit (reproducible via re-clone),
# kept out of git because the trees carry .git history and, for
# agent-data-protocol, 300M+ of upstream datasets. Proper slim-vendoring
# (stripped tree + PIN file, harden-v0 pattern) remains a separate task.
# Already-tracked vendor/harden-v0/ is unaffected (tracked files stay tracked).
/research/external/harbor-ecosystem/vendor/agent-data-protocol/
/research/external/harbor-ecosystem/vendor/atifact/
/research/external/harbor-ecosystem/vendor/vestige/

# CheatBench pinned parquet (research/external/cheatbench/): 500 MB upstream
# artifact, reproducible via fetch.py + PIN. Only the parquet is ignored;
# README.md, PIN and fetch.py stay tracked.
/research/external/cheatbench/*.parquet

# Editors and OS
.DS_Store
.idea/
.vscode/

# In-repo parallel worktrees (agents/WORKFLOW.md)
.worktrees/

# mimo-clean-census (2026-10-10): generated v2 lineage records under
# library/task-variants/ are preserved out-of-git in
# ~/Developer/eval-lab-results/2026-10-10/mimo-clean-census/preserved-v2-lineage/
# (SHA256-verified, exact 7,998/7,998 name match) and must never be committed.
# Tracked files are unaffected; only untracked generated records are hidden.
/library/task-variants/*/*.json
