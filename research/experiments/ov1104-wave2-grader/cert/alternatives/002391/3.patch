+def _deduplicate_vulnerabilities(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Collapse connected groups of advisories that share identifiers."""
+    groups: list[tuple[VulnerabilityResult, set[str]]] = []
+    for vulnerability in vulnerabilities:
+        ids = set(vulnerability.aliases) | {vulnerability.id}
+        matches = [i for i, (_, group_ids) in enumerate(groups) if ids & group_ids]
+        if not matches:
+            groups.append((vulnerability, ids))
+            continue
+
+        # Keep the first result unless a matching result has a PYSEC primary ID.
+        first = matches[0]
+        candidates = [groups[i][0] for i in matches] + [vulnerability]
+        preferred = next((v for v in candidates if v.id.startswith("PYSEC")), candidates[0])
+        for i in matches:
+            ids.update(groups[i][1])
+        groups[first] = (preferred, ids)
+        for i in reversed(matches[1:]):
+            del groups[i]
+
+    return [replace(result, aliases=ids - {result.id}) for result, ids in groups]
 
 
