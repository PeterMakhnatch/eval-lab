+def _collapse_advisories(
+    vulnerabilities: list[VulnerabilityResult],
+) -> list[VulnerabilityResult]:
+    """Merge connected advisories, preserving the preferred result's metadata."""
+    parents = list(range(len(vulnerabilities)))
+
+    def find(index: int) -> int:
+        while parents[index] != index:
+            parents[index] = parents[parents[index]]
+            index = parents[index]
+        return index
+
+    # An identifier can connect more than two records, including transitively.
+    owners = {}
+    for index, vulnerability in enumerate(vulnerabilities):
+        for identifier in vulnerability.aliases | {vulnerability.id}:
+            if identifier in owners:
+                parents[find(index)] = find(owners[identifier])
+            else:
+                owners[identifier] = index
+
+    groups: dict[int, list[VulnerabilityResult]] = {}
+    for index, vulnerability in enumerate(vulnerabilities):
+        groups.setdefault(find(index), []).append(vulnerability)
+
+    collapsed = []
+    for group in groups.values():
+        preferred = next((v for v in group if v.id.startswith("PYSEC")), group[0])
+        identifiers = set()
+        for vulnerability in group:
+            identifiers.add(vulnerability.id)
+            identifiers.update(vulnerability.aliases)
+        identifiers.discard(preferred.id)
+        collapsed.append(replace(preferred, aliases=identifiers))
+    return collapsed
 
 
