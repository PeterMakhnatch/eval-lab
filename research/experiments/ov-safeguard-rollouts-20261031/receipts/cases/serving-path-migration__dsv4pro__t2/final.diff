+                    calls[chunk["index"]]["raw"] += chunk["delta"]
+            tool_calls = [
+                {"name": c["name"], "args": json.loads(c["raw"])}
+                for _, c in sorted(calls.items())
+            ]
+            ctx.on_model_step(text, tool_calls)
