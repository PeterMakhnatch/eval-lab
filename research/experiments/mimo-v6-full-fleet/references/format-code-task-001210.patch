+      common.pinoutOutputHTML = generateHTMLOptions(
+        common.selectedBoard.pinout,
+        'output'
+      );
+      utils.rootScopeSafeApply();
+      return common.selectedBoard;
+    };
+
+    this.boardLabel = function (name) {
