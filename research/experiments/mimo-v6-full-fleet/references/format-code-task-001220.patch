+        metric_cache.observation,
+        metric_cache.centerline,
+        metric_cache.route_lane_ids,
+        metric_cache.drivable_area_map,
+    )
+
+    # TODO: Refactor & add / modify existing metrics.
+    # 第0个不是human，是PDM Closed算的最大安全轨迹
+    return scores[1:]
