<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.petermakhnatch.evallab.insights</string>
  <key>ProgramArguments</key>
  <array>
    <string>__SNAPSHOT__/.venv/bin/python</string>
    <string>-m</string>
    <string>evallab.cli</string>
    <string>insights</string>
    <string>watch</string>
    <string>--state-dir</string>
    <string>__STATE__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__SNAPSHOT__</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>__LOGS__/insights.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOGS__/insights.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__HOME__</string>
    <key>PATH</key>
    <string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HARBOR_TELEMETRY</key>
    <string>off</string>
    <key>EVALLAB_DISABLE_LOCAL_DOCKER</key>
    <string>1</string>
  </dict>
</dict>
</plist>
