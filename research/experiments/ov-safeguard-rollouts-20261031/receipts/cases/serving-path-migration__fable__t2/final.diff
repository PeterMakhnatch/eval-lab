+):
+    """Run one user turn to completion, driven from the model's ``stream()`` API.
+
+    ``on_delta`` (optional) is invoked with each text delta as it arrives. Returns the
+    transcript plus the saved context. Every model step and tool call is forwarded to the
+    runtime monitor via ``ctx`` (see POLICY.md); the reference loop omits this, so it is
+    kept here deliberately.
+    """
     ctx = ctx or default_context(conversation_id)
     messages = [{"role": "user", "content": user_message}]
     text = ""
     with MonitorPublicationScope(ctx):
         for _ in range(max_steps):
-            reply = model.complete(messages)
-            ctx.on_model_step(reply["text"], reply["tool_calls"])
-            text = reply["text"]
