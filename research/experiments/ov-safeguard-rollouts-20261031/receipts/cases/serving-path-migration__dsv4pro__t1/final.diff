+            text, calls = "", {}
+            for chunk in model.stream(messages):
+                if chunk["type"] == "text":
+                    text += chunk["delta"]
+                    if on_delta is not None:
+                        on_delta(chunk["delta"])
+                elif chunk["type"] == "tool_call_start":
