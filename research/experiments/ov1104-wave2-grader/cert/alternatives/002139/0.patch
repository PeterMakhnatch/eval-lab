+"""Fetch Google Cloud Storage objects using the Google Cloud Storage client."""
+
+# SPDX-License-Identifier: GPL-2.0-only
+
+import os
+import bb
+from bb.fetch2 import FetchError, FetchMethod
+
+
+class GCP(FetchMethod):
+    def supports(self, ud, d):
+        return ud.type == 'gs'
+
+    def recommends_checksum(self, ud):
+        return True
+
+    def urldata_init(self, ud, d):
+        ud.basename = ud.parm.get('downloadfilename', os.path.basename(ud.path))
+        ud.localfile = ud.basename
+
+    def _blob(self, ud):
+        # Import lazily so other fetchers do not require the GCS library.
+        try:
+            from google.cloud import storage
+        except ImportError as e:
+            raise FetchError('Google Cloud Storage client is not available: %s' % e, ud.url)
+        return storage.Client().bucket(ud.host).blob(ud.path[1:] if ud.path.startswith('/') else ud.path)
+
+    def download(self, ud, d):
+        bb.fetch2.check_network_access(d, 'Google Cloud Storage download', ud.url)
+        try:
+            blob = self._blob(ud)
+            blob.download_to_filename(ud.localpath)
+        except FetchError:
+            raise
+        except Exception as e:
+            raise FetchError('Google Cloud Storage download failed: %s' % e, ud.url)
+
+        if not os.path.exists(ud.localpath):
+            raise FetchError('Download succeeded but target file %s is missing' % ud.localpath, ud.url)
+        if os.path.getsize(ud.localpath) == 0:
+            os.remove(ud.localpath)
+            raise FetchError('Download produced an empty file; removed %s' % ud.localpath, ud.url)
+        return True
+
+    def checkstatus(self, fetch, ud, d):
+        bb.fetch2.check_network_access(d, 'Google Cloud Storage existence check', ud.url)
+        try:
+            exists = self._blob(ud).exists()
+        except FetchError:
+            raise
+        except Exception as e:
+            raise FetchError('Google Cloud Storage existence check failed: %s' % e, ud.url)
+        if not exists:
+            raise FetchError('Google Cloud Storage object does not exist', ud.url)
+        return True
