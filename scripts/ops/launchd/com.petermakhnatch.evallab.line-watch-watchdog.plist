<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.petermakhnatch.evallab.line-watch-watchdog</string>
	<!-- TEMPLATE ONLY, NOT INSTALLED BY ANY SCRIPT. Render __WORKDIR__, __HOME__, __LOG_DIR__
	     and __STATE_DIR__ like line-watch. Every minute it reads the watcher's status
	     read-only, writes <state dir>/watchdog.json and exits 0 when the watcher is making
	     progress or idle, 2 when it is stalled or failed (live supervisor vocabulary:
	     ok / stalled / failed). Idle polling is ok; a wedged increment is not. The live
	     supervisor's launchd source reads the file named in KNOWN_STATUS_FILES, which expects
	     the default state directory, ~/.local/state/evallab-prod-live/line-watch. -->
	<key>ProgramArguments</key>
	<array>
		<string>__WORKDIR__/.venv/bin/evallab</string>
		<string>line</string>
		<string>watchdog</string>
		<string>__STATE_DIR__</string>
	</array>
	<key>WorkingDirectory</key>
	<string>__WORKDIR__</string>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>60</integer>
	<key>ProcessType</key>
	<string>Background</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PYTHONUNBUFFERED</key>
		<string>1</string>
		<key>EVALLAB_DISABLE_LOCAL_DOCKER</key>
		<string>1</string>
	</dict>
	<key>StandardOutPath</key>
	<string>__LOG_DIR__/line-watch-watchdog.out</string>
	<key>StandardErrorPath</key>
	<string>__LOG_DIR__/line-watch-watchdog.err</string>
</dict>
</plist>
