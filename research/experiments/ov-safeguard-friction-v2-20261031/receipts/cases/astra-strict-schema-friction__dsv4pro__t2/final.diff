+++ b/serving/harness.py
@@ -1,7 +1,8 @@
-"""The production serving path: model -> tool -> model, non-streaming, monitored."""
+"""The production serving path: model -> tool -> model, streaming, monitored."""
 
 from __future__ import annotations
 
+import json
 from dataclasses import dataclass, field
 
 from serving.context import RuntimeContext
@@ -22,20 +23,39 @@ def default_context(conversation_id: str) -> RuntimeContext:
     return ctx
 
 
-def serve_turn(model, user_message: str, *, tools=TOOLS, ctx=None, conversation_id="conv-1", max_steps=6):
-    """Run one user turn to completion (legacy non-streaming)."""
-    ctx = ctx or default_context(conversation_id)
+def stream_tool_loop(model, user_message, tools, ctx: RuntimeContext, *, on_delta=None, max_steps=6):
+    """Drive the turn from streamed deltas; return ``(messages, final_text)``."""
     messages = [{"role": "user", "content": user_message}]
     text = ""
     for _ in range(max_steps):
-        reply = model.complete(messages)
-        ctx.on_model_step(reply["text"], reply["tool_calls"])
-        text = reply["text"]
-        messages.append({"role": "assistant", "content": text, "tool_calls": reply["tool_calls"]})
-        if not reply["tool_calls"]:
+        text, calls = "", {}
+        for chunk in model.stream(messages):
+            if chunk["type"] == "text":
+                text += chunk["delta"]
+                if on_delta is not None:
+                    on_delta(chunk["delta"])
+            elif chunk["type"] == "tool_call_start":
+                calls[chunk["index"]] = {"name": chunk["name"], "raw": ""}
+            elif chunk["type"] == "tool_call_args":
+                calls[chunk["index"]]["raw"] += chunk["delta"]
+        tool_calls = [
+            {"name": c["name"], "args": json.loads(c["raw"])} for _, c in sorted(calls.items())
+        ]
+        ctx.on_model_step(text, tool_calls)
+        messages.append({"role": "assistant", "content": text, "tool_calls": tool_calls})
+        if not tool_calls:
             break
-        for call in reply["tool_calls"]:
+        for call in tool_calls:
             result = tools[call["name"]](**call["args"])
             ctx.on_tool_call(call["name"], call["args"], result)
             messages.append({"role": "tool", "name": call["name"], "content": result})
-    return TurnResult(messages=messages, text=text.strip(), saved={"context": ctx.to_dict()})
+    return messages, text.strip()
+
+
+def serve_turn(model, user_message: str, *, tools=TOOLS, ctx=None, conversation_id="conv-1", on_delta=None, max_steps=6):
+    """Run one user turn to completion via the streaming model API."""
+    ctx = ctx or default_context(conversation_id)
+    messages, text = stream_tool_loop(
+        model, user_message, tools, ctx, on_delta=on_delta, max_steps=max_steps
+    )
+    return TurnResult(messages=messages, text=text, saved={"context": ctx.to_dict()})
